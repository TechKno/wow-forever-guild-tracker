# Docker Compose only. Copy to .env, restrict its permissions, and keep it private.
# SITE_HOSTNAME must match guild.config.json site.origin (without https://).
SITE_HOSTNAME=guild.example.com
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Optional Discord integration. IDs are public configuration; credentials are not.
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_EVENTS_CHANNEL_ID=
DISCORD_CRAFT_REQUESTS_CHANNEL_ID=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=

# Leave unset when using self-host/admin.mjs. The private data/admin-user-ids
# file is loaded automatically after an app restart.
ADMIN_USER_IDS=
