{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guild-ledger",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SECURITY_LIMITS_REQUIRED": "true"
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE",
      "namespace_id": "876500001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "API_RATE",
      "namespace_id": "876500002",
      "simple": {
        "limit": 180,
        "period": 60
      }
    },
    {
      "name": "WRITE_RATE",
      "namespace_id": "876500003",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "LOOKUP_RATE",
      "namespace_id": "876500004",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guild-ledger",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
